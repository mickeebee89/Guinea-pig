# Copy to site/.env.local (gitignored — the root .gitignore's `.env*` is unanchored).
#
# NOTE: no NEXT_PUBLIC_ prefix. The anon key is public by design, but keeping it
# unprefixed makes it unreachable from Client Components, which is what stops a
# client-side query from silently bypassing the ISR cache and breaking SEO.
SUPABASE_URL=https://ptluekkhiopowuyvkgnd.supabase.co
SUPABASE_ANON_KEY=

# 'live' turns indexing on. Anything else = robots disallow all, empty sitemap,
# noindex on every page. Vercel preview deployments must never be 'live'.
PUBLIC_SITE_MODE=preview
