# What EAS Build excludes when uploading the project.
#
# WHY THIS EXISTS: without a .easignore, EAS falls back to .gitignore. This is a
# copy of it, so keep the two in sync when .gitignore changes.
#
# Originally this existed because google-services.json was gitignored and so
# never reached the builder — which fails the build outright, since app.json
# sets android.googleServicesFile. That file is now committed (0106733), so the
# workaround is no longer load-bearing. Kept because .easignore still governs
# the whole upload set, and it's the right place to exclude things worth
# committing but not worth uploading.

# Environment
.env
.env.local

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# EAS build artifacts downloaded locally — no reason to upload them back
artifacts-*.zip

example

# generated native folders
/ios
/android

# NOTE: google-services.json and GoogleService-Info.plist are intentionally NOT
# listed here — they must be uploaded to EAS even though git ignores them.
