{
  "expo": {
    "name": "Guinea Pig",
    "slug": "guinea-pig",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/2552e7c0-8cc8-4dfe-ac8b-80b577e835a0",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.guineapig.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.beauty.guineapig",
          "enableGooglePay": false
        }
      ],
      "./plugins/withGradleJvmArgs",
      "expo-font",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Guinea Pig uses your location to show nearby stylists."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Guinea Pig accesses your photos so you can upload a profile picture, portfolio images, and treatment photos.",
          "cameraPermission": "Guinea Pig uses your camera to take your identity verification selfie and profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2552e7c0-8cc8-4dfe-ac8b-80b577e835a0"
      }
    },
    "owner": "mickeebee89"
  }
}
