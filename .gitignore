# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Nested apps: the leading slash above anchors to the repo root, so each sibling
# app needs its own entry or its build output lands in git.
site/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
site/.next/
site/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code: launch.json is shared, local settings are not
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
supabase/.temp/

# Demo seed images — never commit faces or licensed stock
seed/photos/
