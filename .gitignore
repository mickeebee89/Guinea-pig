# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored on purpose. No app lives at the repo root — admin/, site/ and
# mobile/ are all siblings — so a leading slash would only match a directory
# that no longer exists and would silently miss every real one.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — unanchored, same reasoning as node_modules above
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example files are documentation, not secrets
!.env*.example

# vercel
.vercel

# Claude Code: launch.json is shared, local settings are not
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
supabase/.temp/

# Demo seed images — never commit faces or licensed stock
seed/photos/
